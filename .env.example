# Local Microsoft SQL Server (SSMS)
# Server name is often localhost, .\SQLEXPRESS, or DESKTOP-XXXX\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=FreelanceMarketplace
DB_DRIVER=ODBC Driver 17 for SQL Server

# Windows Authentication (usual with SSMS on your own laptop):
DB_TRUSTED=yes

# Or SQL Server Authentication (sa login). Set DB_TRUSTED=no first:
# DB_TRUSTED=no
# DB_USER=sa
# DB_PASSWORD=YourStrongPasswordHere

# Used only to remember flash messages. Any long random string is fine.
SECRET_KEY=change-this-before-you-demo
